# Copy this file to .env if you want to override paths or label settings.
# .env is gitignored. Do not put passwords or personal information here.
# Relative paths are resolved from the project root (the folder that contains src/).

# Optional directory overrides.
# DATA_RAW_DIR=data/raw
# DATA_INTERIM_DIR=data/interim
# DATA_PROCESSED_DIR=data/processed
# MODELS_DIR=models
# RESULTS_DIR=results

# Use this when data/raw contains more than one downloaded file.
# DATA_RAW_FILE=data/raw/your-download.csv

# Random seed used for later splits and models. Leave at 42 unless the team changes it.
# RANDOM_SEED=42

# Provisional label rule. Leave unset to use 7 calendar days for both.
# Completed requests at or below FAST_SLOW_THRESHOLD_DAYS are Resolved Fast.
# Open requests younger than OBSERVATION_WINDOW_DAYS stay unlabelled.
# FAST_SLOW_THRESHOLD_DAYS=7
# OBSERVATION_WINDOW_DAYS=7

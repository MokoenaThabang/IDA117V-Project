# Byte-compiled
__pycache__/
*.py[cod]

# Virtualenvs
.venv/
venv/
.env

# Local extracts (licence + size — do not commit the full C3 dump or 3M-row splits)
data/raw/
data/processed/*.parquet
data/processed/drive/
*.parquet

# Allow the small sample
!data/sample/
!data/sample/**

# Notebooks / tooling
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Streamlit secrets
.streamlit/secrets.toml

# Municipal extracts and derived tables (keep the folder placeholders)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Fitted models and checkpoints. The models/ folder itself stays in git.
models/*
!models/.gitkeep
*.joblib
# The Streamlit app loads this frozen pipeline and does not refit it.
!models/frozen_resolution_pipeline.joblib
*.pkl
*.pickle
*.h5
*.keras
*.pt
*.pth
*.onnx
# The approved embedding checkpoint and its training-only encoder.
!models/embedding_network.pt
!models/embedding_encoder.joblib

# Isolated notebook reruns copy the processed extract and refit models.
# The execution log and executed notebook copies stay available to commit.
evidence/reproducibility/notebooks/isolated/
